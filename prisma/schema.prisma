generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  plan             String   @default("free")
  tier             String   @default("free")
  polarCustomerId  String?  @unique
  autoRechargeEnabled   Boolean  @default(true)
  autoRechargeThreshold Decimal  @default(1.00) @db.Decimal(8, 2)
  autoRechargeAmount    Decimal  @default(5.00) @db.Decimal(8, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  apiKeys            ApiKey[]
  sessions           Session[]
  usageRecords       UsageRecord[]
  routingLogs        RoutingLog[]
  subscriptions      Subscription[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]

  @@map("users")
}

model CreditBalance {
  userId     String   @id
  balanceUsd Decimal  @db.Decimal(12, 6)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String
  amountUsd    Decimal  @db.Decimal(12, 6)
  balanceAfter Decimal  @db.Decimal(12, 6)
  requestId    String?
  polarOrderId String?  @unique
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  polarSubscriptionId  String    @unique
  polarProductId       String
  tier                 String
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  keyPrefix  String
  name       String?
  rateLimit  Int       @default(100)
  enabled    Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]
  routingLogs  RoutingLog[]

  @@index([keyPrefix])
  @@map("api_keys")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  title        String?
  systemPrompt String?
  currentModel String?
  tokenCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("sessions")
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String
  role         String
  content      String
  modelUsed    String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  sequence     Int

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequence])
  @@map("messages")
}

model Provider {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  baseUrl     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  models         Model[]
  providerHealth ProviderHealth[]

  @@map("providers")
}

model Model {
  id              String   @id @default(cuid())
  providerId      String
  modelName       String   @unique
  displayName     String
  capabilityTags  String[]
  inputCostPer1k  Decimal  @db.Decimal(10, 6)
  outputCostPer1k Decimal  @db.Decimal(10, 6)
  contextWindow   Int      @default(128000)
  priority        Int      @default(5)
  enabled         Boolean  @default(true)
  avgLatencyMs    Int      @default(2000)
  healthStatus    String   @default("healthy")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider     Provider      @relation(fields: [providerId], references: [id])
  usageRecords UsageRecord[]
  routingLogs  RoutingLog[]

  @@index([enabled, priority(sort: Desc)])
  @@map("models")
}

model RoutingRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  strategy    String
  conditions  Json     @default("{}")
  priority    Int      @default(1)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("routing_rules")
}

model RoutingLog {
  id              String   @id @default(cuid())
  requestId       String   @unique
  userId          String
  apiKeyId        String
  sessionId       String?
  requestedModel  String
  selectedModelId String
  strategy        String
  candidatesCount Int
  wasFailover     Boolean  @default(false)
  failedModels    String[]
  latencyMs       Int
  createdAt       DateTime @default(now())

  user          User   @relation(fields: [userId], references: [id])
  apiKey        ApiKey @relation(fields: [apiKeyId], references: [id])
  selectedModel Model  @relation(fields: [selectedModelId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("routing_logs")
}

model UsageRecord {
  id              String   @id @default(cuid())
  requestId       String   @unique
  userId          String
  apiKeyId        String
  sessionId       String?
  modelId         String
  provider        String
  inputTokens     Int
  outputTokens    Int
  totalCostUsd    Decimal  @db.Decimal(12, 8)
  latencyMs       Int
  routingStrategy String
  wasFailover     Boolean  @default(false)
  httpStatus      Int
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])
  model  Model  @relation(fields: [modelId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([modelId, createdAt(sort: Desc)])
  @@map("usage_records")
}

model ProviderHealth {
  id           String   @id @default(cuid())
  providerId   String
  modelName    String
  status       String
  latencyMs    Int?
  errorRate    Float    @default(0)
  checkedAt    DateTime @default(now())
  errorMessage String?

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, modelName, checkedAt(sort: Desc)])
  @@map("provider_health")
}

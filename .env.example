# Unichanl — Local AI Gateway & Web Server
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.

# ========================================
# Database (Supabase PostgreSQL)
# ========================================
# Pooler connection (pgbouncer) — use this in most cases
DATABASE_URL="postgresql://[user]:[password]@[host]:6543/postgres?pgbouncer=true"

# Direct connection — use this only for schema migrations
DIRECT_URL="postgresql://[user]:[password]@[host]:5432/postgres"

# ========================================
# Supabase (Optional, if using Auth)
# ========================================
SUPABASE_URL="https://[project-id].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"

# ========================================
# Redis Cache
# ========================================
# Local development: redis://localhost:6379
# Production: redis://[host]:[port] or use Redis Cloud, ElastiCache, etc.
REDIS_URL="redis://localhost:6379"

# ========================================
# API Keys
# ========================================
# OpenRouter (used for /v1/chat/completions fallback)
OPENROUTER_API_KEY="sk-or-v1-..."

# ========================================
# Security & Server
# ========================================
# JWT secret for API key signing — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="[generate-random-hex-32-bytes]"

# Server port (default: 3001)
PORT=3001

# Allowed CORS origins (comma-separated or "*" for development)
ALLOWED_ORIGINS="*"

# ========================================
# Environment
# ========================================
# development | production
NODE_ENV=development

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

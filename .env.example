# Unichanl — Local AI Gateway & Web Server
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.

# ========================================
# Database (Supabase PostgreSQL)
# ========================================
# Pooler connection (pgbouncer) — use this in most cases
DATABASE_URL="postgresql://[user]:[password]@[host]:6543/postgres?pgbouncer=true"

# Direct connection — use this only for schema migrations
DIRECT_URL="postgresql://[user]:[password]@[host]:5432/postgres"

# ========================================
# Supabase (Optional, if using Auth)
# ========================================
SUPABASE_URL="https://[project-id].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"

# ========================================
# Redis Cache
# ========================================
# Local development: redis://localhost:6379
# Production: redis://[host]:[port] or use Redis Cloud, ElastiCache, etc.
REDIS_URL="redis://localhost:6379"

# ========================================
# API Keys
# ========================================
# OpenRouter (used for /v1/chat/completions fallback)
OPENROUTER_API_KEY="sk-or-v1-..."

# ========================================
# Security & Server
# ========================================
# JWT secret for API key signing — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="[generate-random-hex-32-bytes]"

# Server port (default: 3001)
PORT=3001

# Allowed CORS origins (comma-separated or "*" for development)
ALLOWED_ORIGINS="*"

# ========================================
# Environment
# ========================================
# development | production
NODE_ENV=development

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ========================================
# Polar.sh Billing
# ========================================
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_API_BASE="https://api.polar.sh"

# Subscription tier product IDs (optional; leave blank if unused)
POLAR_PRODUCT_PRO=""
POLAR_PRODUCT_TEAM=""
POLAR_PRODUCT_ENTERPRISE=""

# Single "pay-what-you-want" one-time product for credit top-ups
POLAR_PRODUCT_CREDIT=""

# ========================================
# Credit / Pricing
# ========================================
# Flat markup on upstream cost (1.5 = 50%)
MARKUP_MULTIPLIER=1.5

# Top-up limits (USD)
MIN_TOPUP_USD=5
MAX_TOPUP_USD=1000

# One-time welcome credit granted on signup (USD). Set to 0 to disable.
WELCOME_CREDIT_USD=0.5

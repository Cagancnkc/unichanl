# Provider API keys — required for real routing
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Gateway binding (defaults: 127.0.0.1:20128). Never bind to 0.0.0.0 unless you know what you're doing.
UNICHANL_HOST=127.0.0.1
UNICHANL_PORT=20128

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
NODE_ENV=development

{
  "name": "unichanl",
  "version": "0.1.0",
  "description": "Unichanl — local AI gateway and routing layer for developers. Keeps AI coding workflows running when a provider hits quota, rate limits, or timeouts.",
  "type": "module",
  "bin": {
    "unichanl": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "cli:dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.js",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "inquirer": "^12.1.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.8",
    "ora": "^8.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.17"
  }
}
